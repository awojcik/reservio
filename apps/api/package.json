{
  "name": "@rezervio/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:seed": "tsx src/infrastructure/database/seed/seed.ts",
    "admin:grant": "tsx src/infrastructure/database/grant-role.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "drizzle-orm": "^0.44.7",
    "fastify": "5.11.3",
    "ical.js": "^2.2.1",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.4.1",
    "nodemailer": "^9.0.6",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.16.1",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.0",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
