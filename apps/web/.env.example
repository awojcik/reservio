# Next.js wczytuje .env z katalogu aplikacji, nie z korzenia monorepo.
# Adres API widziany przez przeglądarkę:
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Adres używany przez Next.js po stronie serwera (może być wewnętrzny):
API_INTERNAL_URL=http://localhost:3001/api
# Publiczny adres object storage — z niego wyprowadzany jest images.remotePatterns.
S3_PUBLIC_BASE_URL=http://localhost:9000/rezervio-local
