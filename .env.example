# Skopiuj do .env — plik .env nie trafia do repozytorium.
DATABASE_URL=postgresql://rezervio:rezervio@localhost:5432/rezervio
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Adres API dla przeglądarki. Next.js po stronie serwera używa API_INTERNAL_URL.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
API_INTERNAL_URL=http://localhost:3001/api

# Sesje Host. Token jest opaque, a w bazie trzymamy wyłącznie jego hash.
SESSION_COOKIE_NAME=rezervio_session
SESSION_TTL_SECONDS=604800

# Object storage zgodny z S3. Lokalnie MinIO, produkcyjnie np. DigitalOcean Spaces.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rezervio-local
S3_ACCESS_KEY_ID=rezervio
S3_SECRET_ACCESS_KEY=rezervio-local-only
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/rezervio-local

# Kolejka synchronizacji kalendarzy (BullMQ). Redis NIE jest źródłem prawdy
# o Availability — trzyma wyłącznie zadania.
REDIS_URL=redis://localhost:6379

# Import iCal
ICAL_SYNC_INTERVAL_MINUTES=15
ICAL_FETCH_TIMEOUT_MS=10000
ICAL_MAX_RESPONSE_BYTES=5242880
# 32 bajty w base64 (AES-256-GCM). Wygeneruj własny:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ICAL_URL_ENCRYPTION_KEY=
# WYŁĄCZNIE do developmentu: pozwala pobrać feed iCal z localhost/sieci prywatnej,
# żeby dało się przetestować import lokalnym mockiem. Ignorowane przy
# NODE_ENV=production — na produkcji ochrony SSRF nie da się wyłączyć konfiguracją.
ICAL_ALLOW_PRIVATE_HOSTS=false

# Rezerwacje. Hold blokuje termin na czas finalizacji; po tym czasie wygasa
# i przestaje blokować — niezależnie od tego, czy worker zdążył posprzątać.
BOOKING_HOLD_TTL_SECONDS=600
BOOKING_IDEMPOTENCY_TTL_SECONDS=86400
# Siatka bezpieczenstwa: domyka statusy holdow, ktorych zadanie w kolejce zginelo.
BOOKING_HOLD_SWEEP_MINUTES=5

# Adres aplikacji używany w linkach w emailach. Nigdy nie budujemy ich
# z nagłówka Host żądania.
APP_BASE_URL=http://localhost:3000

# Lokalnie SMTP obsługuje Mailpit (skrzynka: http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=no-reply@rezervio.local

# Prośba o rezerwację wygasa, jeśli gospodarz nie odpowie. Deadline zapisujemy
# w bazie — kolejka jedynie domyka status.
BOOKING_REQUEST_TTL_SECONDS=86400
BOOKING_REQUEST_REMINDER_SECONDS_BEFORE_EXPIRY=14400

# Płatności — Stripe. Rozwój i testy działają WYŁĄCZNIE na kluczach
# testowych/sandbox (sk_test_…, pk_test_…). Klucze live nie są tu potrzebne
# i nie należy ich tu wpisywać.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Sekret podpisu webhooka. Lokalnie wypisuje go `stripe listen` przy starcie:
#   stripe listen --forward-to localhost:3001/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Prowizja Rezervio w punktach bazowych (100 = 1%). Snapshotowana na płatności,
# więc późniejsza zmiana stawki nie przepisuje historii. Rozliczenia
# z gospodarzem to Milestone 10 — tu wystarczy 0.
PLATFORM_FEE_BPS=0

# Szyfrowanie danych dostępu do obiektu (kod do drzwi, keybox). 32 bajty w base64.
# Gdy puste, używany jest ICAL_URL_ENCRYPTION_KEY — wygodne na starcie, ale
# osobny klucz pozwala rotować jedno bez drugiego.
STAY_SENSITIVE_DATA_ENCRYPTION_KEY=

# Siatka bezpieczeństwa domykająca rezerwacje po zakończonym pobycie.
STAY_SWEEP_MINUTES=30

# Rozliczenia z gospodarzem. Środki zwalniają się po zameldowaniu plus ten
# odstęp — polityka, nie stała w domenie. W testach ustawiane osobno.
HOST_SETTLEMENT_RELEASE_DELAY_HOURS=24
# Jak często rekoncyliacja porównuje nasz stan ze stanem u dostawcy.
SETTLEMENT_RECONCILE_MINUTES=15

# --- Milestone 11: hardening i observability ---

# Środowisko aplikacji: development | test | staging | production.
# Bez tego decyduje NODE_ENV. Staging dostaje produkcyjne reguły cookies
# i CORS, wciąż działając na sandboxie Stripe.
APP_ENV=development

# Poziom logów. Każda linia niesie requestId żądania, które ją wywołało.
LOG_LEVEL=info

# Rate limiting. Liczniki żyją w Redisie, bo API ma chodzić w wielu instancjach.
# Każdy bucket można przestroić bez wdrożenia:
#   RATE_LIMIT_<BUCKET>_MAX      liczba żądań w oknie
#   RATE_LIMIT_<BUCKET>_WINDOW   długość okna w sekundach
# Buckety: LOGIN, REGISTER, GUEST_ACCESS, PAYMENT_CREATE, MESSAGE_SEND,
#          ADMIN_SEARCH, ADMIN_ACTION
# RATE_LIMIT_ADMIN_SEARCH_MAX=30

# UWAGA: klucz sk_live_… / rk_live_… zatrzymuje start procesu w KAŻDYM
# środowisku, produkcji nie wyłączając. Rezervio działa wyłącznie w sandboxie;
# przejście na żywe płatności to osobna decyzja, nie zmiana zmiennej.

# --- Milestone 12: integracje z PMS i channel managerami ---

# Klucz szyfrowania danych dostępowych dostawców (32 bajty w base64). Gdy puste,
# używany jest ICAL_URL_ENCRYPTION_KEY — wygodne na starcie, ale osobny klucz
# pozwala rotować dane dostawców bez ruszania adresów iCal i kodów do drzwi.
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=

# Jak często odpytujemy podłączone systemy i jak daleko w przód czytamy
# rezerwacje. Webhook jest szybką ścieżką, polling ścieżką odzyskiwania.
EXTERNAL_SYNC_INTERVAL_MINUTES=15
EXTERNAL_SYNC_HORIZON_DAYS=365

# Adres API widoczny z zewnątrz. Z niego budujemy URL webhooka, który Host
# wkleja w panelu dostawcy — nigdy z nagłówka Host żądania.
API_PUBLIC_URL=http://localhost:3001/api

# Hostaway. Dane dostępowe podaje Host w /host/integrations — tutaj wpisujemy
# wyłącznie adres API i allowlistę domen (SSRF).
HOSTAWAY_API_BASE_URL=https://api.hostaway.com
# HOSTAWAY_ALLOWED_HOSTS=hostaway.com

# Channex. Rezervio jest tu KANAŁEM, nie klientem: to Channex odpytuje nas.
#   CHANNEX_INBOUND_API_KEY  klucz, którym Channex uwierzytelnia się u nas
#   CHANNEX_API_KEY          klucz, którym my dostarczamy rezerwacje do Channexa
# Oba wymagają dostępu partnerskiego: konta staging, zarejestrowanego Open
# Channel i przejścia certyfikacji. Bez nich połączenie raportuje
# PARTNER_ACCESS_REQUIRED, a endpointy kanału odpowiadają 503 — i tak ma być.
CHANNEX_INBOUND_API_KEY=
CHANNEX_API_KEY=
CHANNEX_API_BASE_URL=https://secure.channex.io

# --- Geokodowanie adresów obiektów ---

# Adres gospodarza zamienia na Property.latitude/longitude — jedyne źródło
# prawdy dla wszystkich map. Domyślnie Nominatim (OpenStreetMap): bez konta,
# bez klucza, te same dane co podkład mapy.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

# Polityka Nominatima prosi o User-Agent, pod którym da się kogoś znaleźć.
# Bez tego Rezervio i tak się przedstawia, ale wdrożenie o zauważalnym ruchu
# powinno podać prawdziwy adres kontaktowy.
GEOCODING_CONTACT_EMAIL=

# Allowlista domen (ochrona przed SSRF). Zmieniaj tylko razem z BASE_URL.
# GEOCODING_ALLOWED_HOSTS=nominatim.openstreetmap.org
