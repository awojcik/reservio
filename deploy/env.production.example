# Rezervio — production configuration.
#
#   install -m 600 -o rezervio -g rezervio env.production.example \
#     /opt/rezervio/.env.production
#
# Then fill in every value marked ZMIEŃ. This file never goes to git and never
# goes to GitHub Actions: the only secrets GitHub holds are the ones it needs
# to reach the droplet (PROD_HOST, PROD_USER, PROD_SSH_PRIVATE_KEY).
#
# The API validates this at boot. A missing DATABASE_URL, WEB_ORIGIN,
# APP_BASE_URL, ICAL_URL_ENCRYPTION_KEY or S3_* stops the process — a failed
# deploy, rather than a feature that turns out to be broken on a Friday.
#
# Hasła i klucze wygeneruj jednym przebiegiem, lokalnie:
#   bash deploy/gen-secrets.sh

# --- environment -----------------------------------------------------------
# Production rules for cookies, CORS and HSTS. Still Stripe sandbox.
APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info

# --- addresses -------------------------------------------------------------
# One origin. nginx routes /api/ to the API container, so the browser, the
# session cookie and the Origin check all agree with each other.
WEB_ORIGIN=https://rezervio.pl
APP_BASE_URL=https://rezervio.pl
API_PUBLIC_URL=https://rezervio.pl/api

# --- PostgreSQL ------------------------------------------------------------
# These three are also read by compose to create the container's role, so the
# password here and the one inside DATABASE_URL must match.
POSTGRES_USER=rezervio
POSTGRES_PASSWORD=ZMIEŃ-hasło-bazy
POSTGRES_DB=rezervio
DATABASE_URL=postgresql://rezervio:ZMIEŃ-hasło-bazy@postgres:5432/rezervio

# --- Redis -----------------------------------------------------------------
# Queues only. Availability is never answered from here.
REDIS_URL=redis://redis:6379

# --- sessions --------------------------------------------------------------
SESSION_COOKIE_NAME=rezervio_session
SESSION_TTL_SECONDS=604800

# --- object storage --------------------------------------------------------
# Required in production. Host photos are PUT straight from the browser to a
# presigned URL; the container filesystem is not a fallback, it disappears
# with the next deploy.
#
# Wybierz JEDEN z dwóch wariantów niżej. Oba są S3 — różnią się tylko tym,
# czyj dysk trzyma zdjęcia.

# ---- Wariant A: DigitalOcean Spaces (zalecany) ----------------------------
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_BUCKET=ZMIEŃ-nazwa-bucketa
S3_ACCESS_KEY_ID=ZMIEŃ
S3_SECRET_ACCESS_KEY=ZMIEŃ
# Spaces adresuje bucket subdomeną, MinIO ścieżką.
S3_FORCE_PATH_STYLE=false
# Musi być dokładnie tym, co załaduje przeglądarka, i musi być publiczne.
# Obraz web jest z tym BUDOWANY — zmiana oznacza przebudowę, nie restart.
S3_PUBLIC_BASE_URL=https://ZMIEŃ-nazwa-bucketa.fra1.cdn.digitaloceanspaces.com

# ---- Wariant B: MinIO na tym droplecie ------------------------------------
# Wymaga deploy/compose.storage.yml w /opt/rezervio oraz STORAGE=minio
# w setup.sh. Zakomentuj wariant A i odkomentuj to:
#
#   Endpoint jest publicznym adresem aplikacji, nie adresem kontenera:
#   presigned PUT podpisuje host i ścieżkę, a podpisuje je dla tego adresu,
#   pod który pójdzie przeglądarka. nginx przekazuje /<bucket>/ do MinIO bez
#   przepisywania ścieżki, więc podpis się zgadza.
#
# S3_ENDPOINT=https://rezervio.pl
# S3_REGION=us-east-1
# S3_BUCKET=rezervio-photos          # musi = STORAGE_BUCKET w setup.sh
# S3_ACCESS_KEY_ID=ZMIEŃ             # to samo czyta MinIO jako root user
# S3_SECRET_ACCESS_KEY=ZMIEŃ         # min. 8 znaków; to hasło do storage
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://rezervio.pl/rezervio-photos
# STORAGE_HOST_PORT=9000

# --- encryption ------------------------------------------------------------
# Three separate keys so any one can be rotated without touching the others:
# iCal URLs, door codes, provider credentials.
ICAL_URL_ENCRYPTION_KEY=ZMIEŃ-32-bajty-base64
STAY_SENSITIVE_DATA_ENCRYPTION_KEY=ZMIEŃ-32-bajty-base64
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=ZMIEŃ-32-bajty-base64

# --- Stripe: TEST / SANDBOX ONLY -------------------------------------------
# A live key (sk_live_… / rk_live_…) stops the process from starting, here as
# everywhere else. Going live is a separate, deliberate decision — not an
# edit to this file.
STRIPE_SECRET_KEY=sk_test_ZMIEŃ
STRIPE_WEBHOOK_SECRET=whsec_ZMIEŃ
# Also needed as a build argument for the web image (see the deploy workflow).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_ZMIEŃ
PLATFORM_FEE_BPS=0

# --- email -----------------------------------------------------------------
# Można zostawić na później: email NIGDY nie blokuje transakcji. Powiadomienie
# jest zapisywane w outboxie razem ze zmianą stanu, a wysyłka dzieje się po
# commicie — nieudana ląduje jako FAILED i widać ją w /admin → Problemy
# operacyjne.
#
# Czego brak maili kosztuje, zanim to uzupełnisz:
#   · gość widzi rezerwację od razu (token jest w URL-u), ale po zamknięciu
#     karty nie ma jak do niej wrócić;
#   · gospodarz o nowej prośbie dowie się tylko z pulpitu.
#
# DigitalOcean blokuje wychodzący port 25 — używaj 587.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@rezervio.pl

# --- bookings --------------------------------------------------------------
BOOKING_HOLD_TTL_SECONDS=600
BOOKING_IDEMPOTENCY_TTL_SECONDS=86400
BOOKING_HOLD_SWEEP_MINUTES=5
BOOKING_REQUEST_TTL_SECONDS=86400
BOOKING_REQUEST_REMINDER_SECONDS_BEFORE_EXPIRY=14400
STAY_SWEEP_MINUTES=30
HOST_SETTLEMENT_RELEASE_DELAY_HOURS=24
SETTLEMENT_RECONCILE_MINUTES=15

# --- calendars and integrations --------------------------------------------
ICAL_SYNC_INTERVAL_MINUTES=15
ICAL_FETCH_TIMEOUT_MS=10000
ICAL_MAX_RESPONSE_BYTES=5242880
# SSRF protection cannot be switched off in production; this is here only so
# nobody adds it later by hand.
ICAL_ALLOW_PRIVATE_HOSTS=false
EXTERNAL_SYNC_INTERVAL_MINUTES=15
EXTERNAL_SYNC_HORIZON_DAYS=365
HOSTAWAY_API_BASE_URL=https://api.hostaway.com
CHANNEX_API_BASE_URL=https://secure.channex.io
# Both require partner access that Rezervio does not have yet; empty means the
# channel reports PARTNER_ACCESS_REQUIRED, which is the honest answer.
CHANNEX_INBOUND_API_KEY=
CHANNEX_API_KEY=

# --- geocoding -------------------------------------------------------------
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's policy asks for an address someone can be reached at. Set it.
GEOCODING_CONTACT_EMAIL=ZMIEŃ

# --- resource ceilings (1 vCPU, 2 GB) --------------------------------------
# WORKER_CONCURRENCY can only lower what each worker asks for, never raise it.
WORKER_CONCURRENCY=2
API_HEAP_MB=384
WORKER_HEAP_MB=320
WEB_HEAP_MB=320
REDIS_MAXMEMORY=192mb

# --- backups ---------------------------------------------------------------
# Off-host, or it is not a backup. backup.sh FAILS when these are unset,
# rather than quietly leaving the only copy on the droplet it is protecting.
BACKUP_S3_BUCKET=ZMIEŃ-bucket-backupów
BACKUP_S3_ENDPOINT=https://fra1.digitaloceanspaces.com
BACKUP_S3_REGION=fra1
BACKUP_S3_ACCESS_KEY_ID=ZMIEŃ
BACKUP_S3_SECRET_ACCESS_KEY=ZMIEŃ
BACKUP_S3_PREFIX=postgres
# Tylko przy wariancie B: zdjęcia też muszą wyjechać poza droplet.
BACKUP_PHOTOS_PREFIX=photos
# Set to true ONLY if you accept losing the database together with the droplet.
BACKUP_ALLOW_LOCAL_ONLY=false
