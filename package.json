{
  "name": "rezervio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @rezervio/web dev",
    "dev:api": "pnpm --filter @rezervio/api dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "db:start": "bash scripts/infra.sh start",
    "db:stop": "bash scripts/infra.sh stop",
    "db:reset": "pnpm infra:reset && pnpm db:migrate && pnpm db:seed",
    "db:migrate": "pnpm --filter @rezervio/api db:migrate",
    "db:seed": "pnpm --filter @rezervio/api db:seed",
    "admin:grant": "pnpm --filter @rezervio/api admin:grant",
    "db:generate": "pnpm --filter @rezervio/api db:generate",
    "api:types": "pnpm --filter @rezervio/api-client generate",
    "infra:start": "bash scripts/infra.sh start",
    "infra:stop": "bash scripts/infra.sh stop",
    "infra:reset": "bash scripts/infra.sh reset"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
